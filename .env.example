# Real accounts require Supabase. Without it the app shows a setup screen.
# Optional shared sample data for development only; never use for real players.
ENABLE_DEMO_MODE=false

# --- Supabase (auth + Postgres + storage + RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI provider ---
# Unset => deterministic rule-based coach (real calculations, no LLM prose).
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Billing (Stripe) ---
# Unset => everyone stays on Free and the upgrade button says billing is not set up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The monthly Premium price (price_...) from the Stripe product catalog.
STRIPE_PRICE_ID=
# Server-only: lets the Stripe webhook record a player's plan. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
